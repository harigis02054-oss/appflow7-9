# Copy this file to .env.local and fill in real values there.
# .env.local is already gitignored — never commit real secrets.
# None of these are ever sent to the browser: they're only read inside
# src/app/api/**/route.ts (server-side route handlers).

# --- GitHub ---
# Fine-grained personal access token.
# Recommended scope: Contents (Read & write), limited to the repos this
# platform actually needs (not "all repositories you own").
GITHUB_TOKEN=

# --- Google Play ---
# Paste the full service-account JSON key as a single-line string,
# or set GOOGLE_SERVICE_ACCOUNT_JSON_PATH to a file path instead and load
# it server-side in lib/google-play/client.ts when that integration lands.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# --- Apple App Store Connect ---
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# Paste the .p8 contents with literal \n for newlines, e.g.:
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
APPLE_PRIVATE_KEY=

# --- Android Release Signing (Injected strictly into build worker, never in Git) ---
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# --- Toolchain Paths (Optional overrides if not on system PATH) ---
JAVA_HOME=
FLUTTER_BIN_PATH=/Users/madan.r/development/flutter/bin/flutter
ANDROID_HOME=
